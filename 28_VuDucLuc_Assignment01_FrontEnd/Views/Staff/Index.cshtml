@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div class="container">
        <h1 class="page-title">
            <i class="fas fa-tachometer-alt me-3" style="color:var(--primary-light)"></i>
            Xin chào, @Context.Session.GetString("AccountName")!
        </h1>
        <p class="page-subtitle mt-1">Chào mừng bạn đến với hệ thống quản lý nội dung</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <a asp-controller="Staff" asp-action="NewsArticles" class="text-decoration-none">
                <div class="card h-100 text-center py-4">
                    <div class="mb-3">
                        <div style="width:64px;height:64px;background:rgba(99,102,241,0.15);border-radius:16px;
                            display:flex;align-items:center;justify-content:center;margin:0 auto;">
                            <i class="fas fa-newspaper fa-2x" style="color:var(--primary-light)"></i>
                        </div>
                    </div>
                    <h5 class="fw-600">Quản lý Bài viết</h5>
                    <p class="text-muted-custom small">Tạo, sửa và xóa bài viết</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Staff" asp-action="Categories" class="text-decoration-none">
                <div class="card h-100 text-center py-4">
                    <div class="mb-3">
                        <div style="width:64px;height:64px;background:rgba(34,197,94,0.15);border-radius:16px;
                            display:flex;align-items:center;justify-content:center;margin:0 auto;">
                            <i class="fas fa-folder fa-2x" style="color:var(--success)"></i>
                        </div>
                    </div>
                    <h5 class="fw-600">Quản lý Danh mục</h5>
                    <p class="text-muted-custom small">Tổ chức danh mục nội dung</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Staff" asp-action="MyArticles" class="text-decoration-none">
                <div class="card h-100 text-center py-4">
                    <div class="mb-3">
                        <div style="width:64px;height:64px;background:rgba(249,115,22,0.15);border-radius:16px;
                            display:flex;align-items:center;justify-content:center;margin:0 auto;">
                            <i class="fas fa-history fa-2x" style="color:#f97316"></i>
                        </div>
                    </div>
                    <h5 class="fw-600">Bài viết của tôi</h5>
                    <p class="text-muted-custom small">Xem lịch sử bài viết đã tạo</p>
                </div>
            </a>
        </div>
    </div>
</div>
